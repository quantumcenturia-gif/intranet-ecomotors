# Copia este archivo como .env.local y rellena los valores de tu proyecto Supabase
# (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-o-publishable

# Notion (Notion → Configuración → Conexiones → Desarrollar integraciones → token "Internal")
# Comparte con la integración las bases "Miembros por subárea" y "Calendario general".
NOTION_TOKEN=ntn_tu_token_de_integracion
